<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/monthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.Eclipse.ScreenTitle" />

            <TextView
                android:id="@+id/journalSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/topbar_journal"
                android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dayStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/heroRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_24"
            android:orientation="vertical"
            android:padding="@dimen/space_18">

            <LinearLayout
                android:id="@+id/heroActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/dot_8"
                        android:layout_height="@dimen/dot_8"
                        android:background="@drawable/bg_dot_terracotta" />

                    <TextView
                        android:id="@+id/heroPhaseLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Eclipse.Label" />

                    <TextView
                        android:id="@+id/heroPhaseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_journal_active"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroCycleDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.Eclipse.HeroCounter" />

                <TextView
                    android:id="@+id/heroSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.Eclipse.KickerMono" />

                <TextView
                    android:id="@+id/heroCta"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_cta"
                    android:gravity="center"
                    android:text="@string/today_cta_log"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.Eclipse.ChipLabel" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/dot_8"
                        android:layout_height="@dimen/dot_8"
                        android:background="@drawable/bg_dot_terracotta" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:text="@string/today_start"
                        android:textAppearance="@style/TextAppearance.Eclipse.Label" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/today_start_body"
                    android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

                <TextView
                    android:id="@+id/heroEmptyCta"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_cta"
                    android:gravity="center"
                    android:text="@string/today_cta_first"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.Eclipse.ChipLabel" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/metricRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_20"
                android:minHeight="92dp"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_avg_cycle"
                    android:textAppearance="@style/TextAppearance.Eclipse.Caption" />

                <TextView
                    android:id="@+id/metricCycleValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="---"
                    android:textAppearance="@style/TextAppearance.Eclipse.MetricValueMd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:background="@drawable/bg_card_20"
                android:minHeight="92dp"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_rhythm"
                    android:textAppearance="@style/TextAppearance.Eclipse.Caption" />

                <TextView
                    android:id="@+id/metricRhythmValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="---"
                    android:textAppearance="@style/TextAppearance.Eclipse.MetricValueMd" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/symptomsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/today_symptoms"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_semibold" />

                <TextView
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_4"
                    android:text="@string/today_ubah"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/symptomsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/symptomChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/symptomsEmpty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_20"
                android:gravity="center"
                android:text="@string/today_no_log"
                android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_card_18"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@string/focus_balance"
                android:src="@drawable/ic_lightbulb_outline"
                app:tint="@color/ink_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/focusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_balance"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_semibold" />

                <TextView
                    android:id="@+id/focusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/focus_balance_body"
                    android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>