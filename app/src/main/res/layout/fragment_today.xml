<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dayStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/space_4" />

        <LinearLayout
            android:id="@+id/heroRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/heroPhaseLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phase_none"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Eclipse.Caption" />

            <TextView
                android:id="@+id/heroPhaseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/phase_none"
                android:textAppearance="@style/TextAppearance.Eclipse.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroCycleDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:text="–"
                    android:textColor="@color/ink"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heroUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_marginBottom="6dp"
                    android:text="@string/today_label_day"
                    android:textAppearance="@style/TextAppearance.Eclipse.Label" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Eclipse.Body" />
        </LinearLayout>

        <TextView
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_height"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_cta"
            android:gravity="center"
            android:text="@string/today_cta"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.Eclipse.Label" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dot_teal"
                android:contentDescription="@string/today_no_data_title"
                android:padding="@dimen/space_16"
                android:src="@drawable/ic_drop"
                app:tint="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/today_no_data_title"
                android:textAppearance="@style/TextAppearance.Eclipse.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/today_no_data_body"
                android:textAppearance="@style/TextAppearance.Eclipse.Body" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>