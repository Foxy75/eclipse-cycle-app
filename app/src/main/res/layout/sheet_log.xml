<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/logTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_title"
            android:textAppearance="@style/TextAppearance.Eclipse.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/log_flow"
            android:textAppearance="@style/TextAppearance.Eclipse.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/flowGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlow0"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/flow_none" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlow1"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_spotting" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlow2"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_light" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlow3"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_medium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlow4"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_heavy" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/log_symptoms"
            android:textAppearance="@style/TextAppearance.Eclipse.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/symptomGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:chipSpacingVertical="@dimen/space_8">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom0"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_cramps" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom1"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_headache" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom2"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_nausea" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom3"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_bloating" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom4"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_backache" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom5"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_breast" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom6"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_fatigue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSymptom7"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symptom_acne" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/log_mood"
            android:textAppearance="@style/TextAppearance.Eclipse.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/moodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:chipSpacingVertical="@dimen/space_8"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMood0"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_calm" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMood1"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_happy" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMood2"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_neutral" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMood3"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_anxious" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMood4"
                style="@style/Widget.Eclipse.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mood_irritable" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/log_note"
            android:textAppearance="@style/TextAppearance.Eclipse.Label" />

        <EditText
            android:id="@+id/noteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_field"
            android:gravity="top"
            android:hint="@string/log_note_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="200"
            android:minLines="3"
            android:padding="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.Eclipse.Body"
            android:textColorHint="@color/ink_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_height"
                android:background="@drawable/bg_cta"
                android:gravity="center"
                android:text="@string/log_save"
                android:textColor="@color/white"
                android:textAppearance="@style/TextAppearance.Eclipse.Label" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_height"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:text="@string/log_delete"
                android:textColor="@color/terracotta"
                android:textAppearance="@style/TextAppearance.Eclipse.Label"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>