<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <!-- ================= TOP HEADER WAWASAN ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ins_title"
                    android:textAppearance="@style/TextAppearance.Eclipse.ScreenTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ins_kicker"
                    android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
            </LinearLayout>

            <!-- Tombol Ekspor/Backup -->
            <ImageButton
                android:id="@+id/btnExportBackup"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/set_export"
                android:padding="11dp"
                android:src="@drawable/ic_download_outline"
                app:tint="@color/ink" />
        </LinearLayout>

        <!-- ================= STATE KOSONG (BELUM CUKUP DATA) ================= -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_24"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_dot_teal"
                android:contentDescription="@string/ins_empty_title"
                android:padding="@dimen/space_16"
                android:src="@drawable/ic_chart"
                app:tint="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/ins_empty_title"
                android:textAppearance="@style/TextAppearance.Eclipse.CardTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/ins_empty_body"
                android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
        </LinearLayout>

        <!-- ================= CONTENT STATE (ADA DATA SIKLUS) ================= -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 1. KARTU GRAFIK BATANG (6 SIKLUS TERAKHIR) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_card_24"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <!-- Header Grafik -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ins_chart_kicker"
                        android:textAppearance="@style/TextAppearance.Eclipse.KickerSans" />

                    <TextView
                        android:id="@+id/tvTargetCycle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Eclipse.KickerMono"
                        tools:text="— Target 28h" />
                </LinearLayout>

                <!-- Custom Bar Chart View -->
                <io.github.foxy75.eclipse.ui.insights.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="@dimen/space_12" />

                <!-- Footer Grafik -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/dot_8"
                            android:layout_height="@dimen/dot_8"
                            android:background="@drawable/bg_dot_terracotta" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/ins_chart_actual"
                            android:textAppearance="@style/TextAppearance.Eclipse.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCycleRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Eclipse.KickerMono"
                        tools:text="Rentang 27-31 hari" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. BARIS 2 KARTU METRIK WAWASAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Kartu Kiri: Rata-rata Siklus -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_20"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ins_avg"
                        android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/avgCycleValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Eclipse.MetricValue"
                            tools:text="29" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/onb_unit_days"
                            android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBasedOnCycles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Eclipse.Caption"
                        tools:text="Berdasarkan 6 siklus" />
                </LinearLayout>

                <!-- Kartu Kanan: Variasi Ritme -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_20"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ins_variation"
                        android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvVariationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Eclipse.MetricValue"
                            tools:text="±2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/onb_unit_days"
                            android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dotStability"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_teal" />

                        <TextView
                            android:id="@+id/stabilityTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/outfit_medium"
                            android:textColor="@color/ink"
                            android:textSize="11sp"
                            tools:text="Ritme stabil" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. KARTU GEJALA TERSERING BULAN INI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_24"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ins_common"
                    android:textAppearance="@style/TextAppearance.Eclipse.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ins_common_sub"
                    android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

                <!-- Container 3 Baris Gejala -->
                <LinearLayout
                    android:id="@+id/layoutTopSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:orientation="vertical">

                    <!-- Baris 1 -->
                    <LinearLayout
                        android:id="@+id/rowSymptom1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/iconSymptom1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_button_sm"
                            android:padding="8dp"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/ink" />

                        <TextView
                            android:id="@+id/tvSymptom1Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/outfit_semibold"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            tools:text="Kram" />

                        <TextView
                            android:id="@+id/tvSymptom1Count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_canvas"
                            android:fontFamily="monospace"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/ink_secondary"
                            android:textSize="11sp"
                            tools:text="6 hari" />
                    </LinearLayout>

                    <!-- Baris 2 -->
                    <LinearLayout
                        android:id="@+id/rowSymptom2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/iconSymptom2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_button_sm"
                            android:padding="8dp"
                            android:src="@drawable/ic_target"
                            app:tint="@color/ink" />

                        <TextView
                            android:id="@+id/tvSymptom2Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/outfit_semibold"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            tools:text="Sakit kepala" />

                        <TextView
                            android:id="@+id/tvSymptom2Count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_canvas"
                            android:fontFamily="monospace"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/ink_secondary"
                            android:textSize="11sp"
                            tools:text="4 hari" />
                    </LinearLayout>

                    <!-- Baris 3 -->
                    <LinearLayout
                        android:id="@+id/rowSymptom3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/iconSymptom3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_button_sm"
                            android:padding="8dp"
                            android:src="@drawable/ic_battery_low"
                            app:tint="@color/ink" />

                        <TextView
                            android:id="@+id/tvSymptom3Name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/outfit_semibold"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            tools:text="Lelah" />

                        <TextView
                            android:id="@+id/tvSymptom3Count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_canvas"
                            android:fontFamily="monospace"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/ink_secondary"
                            android:textSize="11sp"
                            tools:text="3 hari" />
                    </LinearLayout>

                    <!-- Empty state gejala -->
                    <TextView
                        android:id="@+id/tvEmptySymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center"
                        android:text="@string/ins_common_none"
                        android:textAppearance="@style/TextAppearance.Eclipse.BodySm"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/ins_common_foot"
                    android:textAppearance="@style/TextAppearance.Eclipse.Caption" />
            </LinearLayout>

            <!-- 4. BANNER PRIVASI BAWAH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="80dp"
                android:background="@drawable/bg_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_outline"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:layout_weight="1"
                    android:text="@string/ins_privacy"
                    android:textAppearance="@style/TextAppearance.Eclipse.Caption" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
