<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="@dimen/icon_button"
        android:layout_height="@dimen/icon_button"
        android:layout_marginTop="@dimen/space_24"
        android:contentDescription="@string/lock_title"
        android:padding="12dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/ink_secondary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:text="@string/lock_title"
        android:textAppearance="@style/TextAppearance.Eclipse.Title" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="@string/lock_subtitle"
        android:textAppearance="@style/TextAppearance.Eclipse.Label" />

    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:orientation="horizontal" />

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@null"
        android:cursorVisible="false"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Eclipse.Label"
        android:visibility="gone" />
</LinearLayout>