<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/personalizeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/avatarPreview"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar"
                android:padding="10dp"
                android:src="@drawable/ic_avatar_moon"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONALISASI"
                    android:textAppearance="@style/TextAppearance.Eclipse.KickerSans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Persona &amp; Palet Warna"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit_semibold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_sm"
                android:contentDescription="@string/close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@color/ink" />
        </LinearLayout>

        <!-- ================= SECTION 0: MODE TAMPILAN ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mode Tampilan"
            android:textAppearance="@style/TextAppearance.Eclipse.CardTitle"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih pencahayaan yang paling nyaman untuk matamu"
            android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Mode Terang (Light) -->
            <LinearLayout
                android:id="@+id/cardModeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_theme_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iconModeLight"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sun"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/labelModeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="Terang"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mode Gelap (Dark) -->
            <LinearLayout
                android:id="@+id/cardModeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iconModeDark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:id="@+id/labelModeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Gelap"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mode Sistem (System) -->
            <LinearLayout
                android:id="@+id/cardModeSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iconModeSystem"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_monitor"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:id="@+id/labelModeSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/outfit_medium"
                    android:text="Sistem"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SECTION 1: PERSONA AVATAR ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Pilih Persona Avatar"
            android:textAppearance="@style/TextAppearance.Eclipse.CardTitle"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Avatar ini akan mewakili dirimu di pojok kanan atas aplikasi"
            android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

        <!-- 8 Avatar Grid (2 Baris x 4 Kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Baris 1: Moon, Flower, Sparkles, Leaf -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <FrameLayout
                    android:id="@+id/btnAvatar0"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card_selected"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar0"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_moon"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar1"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_flower"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar2"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar3"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_leaf"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Baris 2: Butterfly, Zen, Coffee, Cat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <FrameLayout
                    android:id="@+id/btnAvatar4"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_butterfly"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar5"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar5"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_zen"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar6"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar6"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_coffee"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar7"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconAvatar7"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_cat"
                        app:tint="@color/ink_secondary" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SECTION 2: PALET WARNA ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tema &amp; Palet Warna"
            android:textAppearance="@style/TextAppearance.Eclipse.CardTitle"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih palet warna yang mewakili energi dan kenyamananmu"
            android:textAppearance="@style/TextAppearance.Eclipse.BodySm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- Theme 0: Terracotta -->
            <LinearLayout
                android:id="@+id/cardTheme0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_theme_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_terracotta_primary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_terracotta_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Earthy Terracotta (Default)"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hangat, alami, &amp; berakar tenang"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkTheme0"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Theme 1: Flo Rose -->
            <LinearLayout
                android:id="@+id/cardTheme1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_flo_primary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_flo_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flo Rose Petal"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nuansa lembut, feminin, &amp; anggun khas Flo"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkTheme1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Theme 2: Lavender Mist -->
            <LinearLayout
                android:id="@+id/cardTheme2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_lavender_primary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_lavender_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lavender Mist"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menenangkan pikiran, nyaman saat fase PMS"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkTheme2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Theme 3: Sage & Matcha -->
            <LinearLayout
                android:id="@+id/cardTheme3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_sage_primary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_sage_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sage &amp; Matcha"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Segar, organik, &amp; selaras dengan alam"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkTheme3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Theme 4: Midnight Velvet -->
            <LinearLayout
                android:id="@+id/cardTheme4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_midnight_primary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/palette_midnight_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midnight Velvet"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kemewahan sunyi &amp; aksen champagne gold"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkTheme4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SECTION 3: NAMA PANGGILAN ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nama Panggilan Kamu"
            android:textAppearance="@style/TextAppearance.Eclipse.CardTitle"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputNickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="Misal: Luna, Alya, Bunda"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="24"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_secondary"
            android:textSize="14sp" />

        <!-- ================= SECTION 4: AFIRMASI SIKLUS ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Afirmasi Ritme Tubuh"
            android:textAppearance="@style/TextAppearance.Eclipse.CardTitle"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/mottoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnMotto0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_theme_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="💫 “Tubuhku tahu ritmenya, aku menghargainya.”"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMotto1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="🌸 “Hari ini aku melambat dan bernapas lega.”"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMotto2"
                android:layout_width="match_parent"
