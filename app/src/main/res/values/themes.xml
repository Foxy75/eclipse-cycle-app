<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Eclipse" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_tint</item>
        <item name="colorOnPrimaryContainer">@color/teal</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/canvas</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.Eclipse" parent="Base.Theme.Eclipse" />

    <style name="Widget.Eclipse.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>